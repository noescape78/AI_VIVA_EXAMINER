# ==============================================================================
# VivaAI.Pro — Environment Configuration Example
# Copy this file to .env and insert your API keys
# ==============================================================================

# 1. Google Gemini Flash (Recommended: Ultra-fast sub-second latency)
# You can provide multiple comma-separated keys for auto-failover & rate-limit immunity
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. OpenRouter API (Alternative / Fallback)
OPENROUTER_API_KEYS=sk-or-v1-your-key-here
DEFAULT_MODEL=thinkingmachines/inkling-small:free
FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free

# 3. Server Port
PORT=8000
